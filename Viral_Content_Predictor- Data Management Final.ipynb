    "    best_models[platform] = (best_name, all_results[platform][best_name]['pipeline'])\n",
    "    print(f'  {platform:12s} → Best Model: {best_name}  (AUC: {all_results[platform][best_name][\"metrics\"][\"roc_auc\"]:.3f})')\n",
    "\n",
    "print()\n",
